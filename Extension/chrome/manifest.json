{
  "manifest_version": 3,
  "name": "OpenClicky",
  "description": "Lets OpenClicky's agents read and act in your browser tabs when you ask them to.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "OpenClicky",
    "default_popup": "popup.html"
  }
}
